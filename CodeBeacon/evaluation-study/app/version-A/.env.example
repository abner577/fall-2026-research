# Copy to .env for a new checkout. Paths are relative to this project folder.
# Process environment variables override this file.

# Backend: loopback access, HTTPS, and debug disabled.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8443
BACKEND_DEBUG=false
BACKEND_TLS_CERT_FILE=.local/tls/server.crt
BACKEND_TLS_KEY_FILE=.local/tls/server.key
APP_SECRET_KEY=
ACCOUNT_TOKEN_TTL_SECONDS=3600
LOG_LEVEL=INFO

# PostgreSQL: use a dedicated role and a TLS-enabled local server.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=room_monitor_a
DB_USER=room_monitor_app
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT_SECONDS=5

# Streamlit and firmware call Flask; neither connects directly to PostgreSQL.
# The certificate file is the trust anchor for this local self-signed server.
API_BASE_URL=https://localhost:8443
API_CA_BUNDLE=.local/tls/server.crt
API_CONNECT_TIMEOUT_SECONDS=3
API_READ_TIMEOUT_SECONDS=10

# The bundled device profile is room-monitor-01. Other devices need both values.
DEVICE_ID=room-monitor-01
DEVICE_TOKEN=
DEVICE_READING_INTERVAL_SECONDS=5
DEVICE_COMMAND_POLL_INTERVAL_SECONDS=2
DEVICE_RECONNECT_DELAY_SECONDS=5
FIRMWARE_LOG_FILE=.local/logs/firmware.log

# Sensor settings; temperature values are Celsius.
SENSOR_SEED=2026
SENSOR_START_TEMPERATURE_C=24.0
SENSOR_AMBIENT_TEMPERATURE_C=26.0
SENSOR_FAN_COOLING_C_PER_SECOND=0.05
SENSOR_NOISE_STDDEV_C=0.05
SENSOR_THERMAL_TIME_CONSTANT_SECONDS=300
