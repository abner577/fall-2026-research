# Copy to .env for a new checkout. All paths are relative to version-A/.
# Fill required secrets locally. Do not put detector-provider API keys here.

# Backend: loopback access, HTTPS, and debug disabled.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8443
BACKEND_DEBUG=false
BACKEND_TLS_CERT_FILE=.local/tls/server.crt
BACKEND_TLS_KEY_FILE=.local/tls/server.key
APP_SECRET_KEY=
ACCOUNT_TOKEN_TTL_SECONDS=3600
LOG_LEVEL=INFO

# PostgreSQL: create this dedicated role and database before starting Flask.
# sslmode=prefer is for the loopback-only local database, not remote deployment.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=room_monitor_a
DB_USER=room_monitor_app
DB_PASSWORD=
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT_SECONDS=5

# Streamlit and firmware call Flask; neither connects directly to PostgreSQL.
# The certificate file is the trust anchor for this local self-signed server.
API_BASE_URL=https://localhost:8443
API_CA_BUNDLE=.local/tls/server.crt
API_CONNECT_TIMEOUT_SECONDS=3
API_READ_TIMEOUT_SECONDS=10

# Fill these after registering an account and enrolling its device in the UI.
DEVICE_ID=
DEVICE_TOKEN=
DEVICE_READING_INTERVAL_SECONDS=5
DEVICE_COMMAND_POLL_INTERVAL_SECONDS=2
DEVICE_RECONNECT_DELAY_SECONDS=5

# Simulated temperature values are Celsius; the seed is not a credential.
# The exact sensor model will be implemented in firmware/temperature_sensor.py.
SIMULATION_SEED=2026
SIMULATION_START_TEMPERATURE_C=24.0
SIMULATION_AMBIENT_TEMPERATURE_C=26.0
SIMULATION_FAN_COOLING_C_PER_SECOND=0.05
SIMULATION_NOISE_STDDEV_C=0.05
